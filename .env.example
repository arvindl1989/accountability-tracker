# server.js reads these. On Railway, DATABASE_URL is set for you when you add a
# Postgres service; CLUB_KEY is the one you add yourself.

# Where the data lives. Without it the app is still served, but the data API is off.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# The shared key the three of you paste into Settings -> Shared board.
# Any long random string. Without it the data API stays off, so the server is
# never unintentionally open to the internet.
CLUB_KEY=change-me-to-something-long-and-random

# Optional. The host usually sets this; 8080 is the fallback.
# PORT=8080
